#!/usr/bin/env bash
echo
printf "Touch YubiKey: "
y=""
for ((i=0; i<32; i++)); do
    IFS= read -rsN1 c
    y+="$c"
    printf '*'
done
echo
exec dev connect -t www_fbsource_configerator:ent_framework -y "$y" -- bash -c 'dotsync2 pull >/dev/null 2>&1; TERM=xterm-256color exec tmux new -A -D -s main'
