#!/usr/bin/env bash
echo
printf "Touch YubiKey: "
y=""
for ((i=0; i<32; i++)); do
    IFS= read -rsN1 c
    y+="$c"
    printf '*'
done
echo
exec dev connect -n devvm10852.eag0 -y "$y" -- bash -c 'export TERM=xterm-256color; echo "Waiting for OnDemand init (dotfiles + devfeature)..."; systemctl --user start dotfiles.target 2>/dev/null & for i in $(seq 1 600); do devfeature status 2>&1 | grep -q "Initial sync: successful" && break; sleep 0.2; done & wait; tmux has-session -t main 2>/dev/null || tmux start-server \; set-option -g default-command "exec bash -l" \; new-session -d -s main \; set-window-option main-pane-width 62% \; split-window -h \; split-window -v \; select-layout main-vertical \; send-keys -t 0 "doom" Enter \; select-pane -t 0; exec tmux attach -d -t main'
