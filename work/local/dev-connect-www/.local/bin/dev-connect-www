#!/usr/bin/env bash
echo
printf "Touch YubiKey: "
y=""
for ((i=0; i<32; i++)); do
    IFS= read -rsN1 c
    y+="$c"
    printf '*'
done
echo
exec dev connect -t www -y "$y" -- bash -c 'export TERM=xterm-256color; sp="|/-"; systemctl --user start dotfiles.target 2>/dev/null & d=$!; ( for i in $(seq 1 600); do devfeature status 2>&1 | grep -q "Initial sync: successful" && break; sleep 0.2; done ) & f=$!; n=0; while kill -0 $d 2>/dev/null || kill -0 $f 2>/dev/null; do c=${sp:n%${#sp}:1}; n=$((n+1)); kill -0 $d 2>/dev/null && a="$c" || a="ok"; kill -0 $f 2>/dev/null && b="$c" || b="ok"; printf "\r  [%s] dotfiles   [%s] devfeature " "$a" "$b"; sleep 0.1; done; printf "\r  [ok] dotfiles   [ok] devfeature\n"; tmux has-session -t main 2>/dev/null || tmux start-server \; set-option -g default-command "exec bash -l" \; new-session -d -s main \; set-window-option main-pane-width 62% \; split-window -h \; split-window -v \; select-layout main-vertical \; send-keys -t 0 "doom" Enter \; select-pane -t 0; exec tmux attach -d -t main'
