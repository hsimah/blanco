#!/usr/bin/env bash
# Move the MP4 'moov' atom to the front (web-streamable / faststart), losslessly.
# Usage: faststart-mp4 <file.mp4>   — edits the file in place, only if needed.
set -euo pipefail

f="${1:?usage: faststart-mp4 <file.mp4>}"
[ -f "$f" ] || { echo "no such file: $f" >&2; exit 1; }
case "$f" in *.mp4|*.MP4) ;; *) exit 0 ;; esac   # only touch mp4

# Skip if moov already precedes mdat (already faststart) or atoms unreadable.
if python3 - "$f" <<'PY'
import sys,struct
data=open(sys.argv[1],'rb').read()
i=0;order=[]
while i+8<=len(data):
    size=struct.unpack('>I',data[i:i+4])[0]; typ=data[i+4:i+8].decode('latin1','replace')
    order.append(typ)
    if size==1: size=struct.unpack('>Q',data[i+8:i+16])[0]
    if size==0: break
    i+=size
sys.exit(0 if ('moov' in order and 'mdat' in order and order.index('moov')<order.index('mdat')) else 1)
PY
then
    exit 0   # already good
fi

# temp name has NO .mp4 extension so the directory watcher ignores it
tmp="$(mktemp --tmpdir="$(dirname "$f")" .faststart.XXXXXX.tmp)"
trap 'rm -f "$tmp"' EXIT
ffmpeg -nostdin -loglevel error -y -i "$f" -c copy -movflags +faststart -f mp4 "$tmp"
# preserve timestamps, then atomically replace
touch -r "$f" "$tmp"
mv -f "$tmp" "$f"
trap - EXIT
echo "faststarted: $f"
