#!/usr/bin/env bash
# Faststart every .mp4 in the given directories (idempotent — already-good files skipped).
shopt -s nullglob
dirs=("$@")
[ ${#dirs[@]} -eq 0 ] && dirs=("$HOME/Videos" "$HOME/Videos/Screencasts")
for d in "${dirs[@]}"; do
    [ -d "$d" ] || continue
    for f in "$d"/*.mp4 "$d"/*.MP4; do
        "$HOME/.local/bin/faststart-mp4" "$f" || echo "faststart-dir: failed on $f" >&2
    done
done
