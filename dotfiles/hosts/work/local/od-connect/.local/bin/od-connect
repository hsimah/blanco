#!/usr/bin/env bash
# Shared OnDemand launcher. Prompts for a YubiKey touch, connects, and hands
# `dev connect` a bootstrap that waits for host init then builds the tmux session
# (see od-tmux-boot.sh). The bootstrap is gzip+base64-embedded into the PROG so
# it survives `dev connect` typing it into the remote shell as `exec <PROG>`.
#
# A persistent host needs none of that: `--prog` passes a command straight
# through as PROG instead, which is the form `dev connect --help` documents
# (`dev connect -- tmux attach -d`).
#
# usage: od-connect [--prog <command>] <dev connect args...>
#   e.g. od-connect -t www
#        od-connect --prog "tmux new-session -A -D -s main" -n devvm123
set -u

prog=""
if [[ ${1:-} == --prog ]]; then
    prog=$2
    shift 2
fi

echo
printf "Touch YubiKey: "
y=""
for ((i = 0; i < 32; i++)); do
    IFS= read -rsN1 c
    y+="$c"
    printf '*'
done
echo

if [[ -n $prog ]]; then
    # shellcheck disable=SC2086  # PROG is a command line, split it deliberately
    exec dev connect "$@" -y "$y" -- $prog
fi

gz="$(gzip -9 -n -c ~/.local/share/od-connect/od-tmux-boot.sh | base64 -w0)"
exec dev connect "$@" -y "$y" -- bash -c "base64 -d <<< $gz | gunzip > ~/.od-boot.sh; exec bash ~/.od-boot.sh"
