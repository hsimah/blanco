#!/usr/bin/env bash
# Shared OnDemand launcher: prompts for a YubiKey touch, then `dev connect`.
# Without `--`, PROG is od-tmux-boot.sh (gzip+base64, since `dev connect` types
# PROG into the remote shell). After `--`, args pass through one argv element
# each, as `dev connect` shell-quotes them individually.
#
# usage: od-connect <dev connect args...> [-- <prog...>]
set -u

args=()
prog=()
sep=0
for a in "$@"; do
    if ((sep == 0)) && [[ $a == -- ]]; then
        sep=1
        continue
    fi
    if ((sep)); then prog+=("$a"); else args+=("$a"); fi
done

echo
printf "Touch YubiKey: "
y=""
for ((i = 0; i < 32; i++)); do
    IFS= read -rsN1 c
    y+="$c"
    printf '*'
done
echo

if ((${#prog[@]})); then
    exec dev connect "${args[@]}" -y "$y" -- "${prog[@]}"
fi

gz="$(gzip -9 -n -c ~/.local/share/od-connect/od-tmux-boot.sh | base64 -w0)"
exec dev connect "${args[@]}" -y "$y" -- bash -c "base64 -d <<< $gz | gunzip > ~/.od-boot.sh; exec bash ~/.od-boot.sh"
