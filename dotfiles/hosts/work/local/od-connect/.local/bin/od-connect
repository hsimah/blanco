#!/usr/bin/env bash
# Shared OnDemand launcher. Prompts for a YubiKey touch, then connects.
#
# With no `--`, hands `dev connect` the OnDemand bootstrap that waits for host
# init then builds the tmux session (see od-tmux-boot.sh). The bootstrap is
# gzip+base64-embedded into the PROG so it survives `dev connect` typing it into
# the remote shell as `exec <PROG>`.
#
# Anything after `--` is passed through as PROG verbatim, one argv element each
# — `dev connect` shell-quotes them individually, so a single pre-quoted string
# would arrive as one unfindable command name. A persistent host wants this form.
#
# usage: od-connect <dev connect args...> [-- <prog...>]
#   e.g. od-connect -t www
#        od-connect -n devvm123 -- tmux new-session -A -D -s main
set -u

args=()
prog=()
sep=0
for a in "$@"; do
    if ((sep == 0)) && [[ $a == -- ]]; then
        sep=1
        continue
    fi
    if ((sep)); then prog+=("$a"); else args+=("$a"); fi
done

echo
printf "Touch YubiKey: "
y=""
for ((i = 0; i < 32; i++)); do
    IFS= read -rsN1 c
    y+="$c"
    printf '*'
done
echo

if ((${#prog[@]})); then
    exec dev connect "${args[@]}" -y "$y" -- "${prog[@]}"
fi

gz="$(gzip -9 -n -c ~/.local/share/od-connect/od-tmux-boot.sh | base64 -w0)"
exec dev connect "${args[@]}" -y "$y" -- bash -c "base64 -d <<< $gz | gunzip > ~/.od-boot.sh; exec bash ~/.od-boot.sh"
