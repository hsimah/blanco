workspace "personal" {
    open-on-output "Samsung Display Corp. 0x419F Unknown"
}
workspace "work" {
    open-on-output "Dell Inc. DELL P3222QE D135T83"
}

spawn-at-startup "flatpak" "run" "com.plexamp.Plexamp"
spawn-at-startup "google-chrome-stable" "--profile-directory=Default" "--app-id=pommaclcbfghclhalboakcipcmmndhcj"

window-rule {
    match app-id="plexamp"
    open-on-workspace "personal"
    default-column-width { proportion 1.0; }
}
window-rule {
    match app-id="chrome-hfmgjhflhflcobjffcknlgaphippkmmd-Default"
    open-on-workspace "personal"
    default-column-width { proportion 1.0; }
}
window-rule {
    match app-id="chrome-pommaclcbfghclhalboakcipcmmndhcj-Default"
    open-on-workspace "work"
}

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

binds {
    Super+BackSpace hotkey-overlay-title="Lock the Screen: noctalia" { spawn-sh "noctalia msg session lock"; }
}

debug {
    honor-xdg-activation-with-invalid-serial
}

switch-events {
    lid-close {
        spawn "noctalia" "msg" "session" "lock-and-suspend"
    }
}
