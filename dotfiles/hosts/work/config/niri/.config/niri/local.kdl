workspace "personal" {
    open-on-output "Samsung Display Corp. 0x419F Unknown"
}
workspace "work" {
    open-on-output "Dell Inc. DELL P3222QE D135T83"
}

spawn-at-startup "flatpak" "run" "com.plexamp.Plexamp"
spawn-at-startup "google-chrome-stable" "--profile-directory=Default" "--app-id=pommaclcbfghclhalboakcipcmmndhcj"

window-rule {
    match app-id="plexamp"
    open-on-workspace "personal"
    default-column-width { proportion 1.0; }
}
window-rule {
    match app-id="chrome-hfmgjhflhflcobjffcknlgaphippkmmd-Default"
    open-on-workspace "personal"
    default-column-width { proportion 1.0; }
}
window-rule {
    match app-id="chrome-pommaclcbfghclhalboakcipcmmndhcj-Default"
    open-on-workspace "work"
}

layer-rule {
    match namespace="^noctalia-overview-"
    place-within-backdrop true
}

binds {
    Super+BackSpace hotkey-overlay-title="Lock the Screen: noctalia" { spawn-sh "qs -c noctalia-shell ipc call lockScreen lock"; }
    Ctrl+Print hotkey-overlay-title="Toggle Screen Recording: noctalia" { spawn-sh "qs -c noctalia-shell ipc call plugin:screen-recorder toggle"; }
}

switch-events {
    lid-close {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "sessionMenu" "lockAndSuspend"
    }
}
