output "eDP-1" {
    scale 2
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 2000
}

workspace "ha"
workspace "music"
workspace "radarr"
workspace "sonarr"
workspace "lidarr"
workspace "homepage"
workspace "terminal"

binds {
    XF86PowerOff { power-off-monitors; }
}

spawn-sh-at-startup "exec ~/.local/bin/loft-app ha https://capcom.loft.hsimah.com/"
spawn-sh-at-startup "exec ~/.local/bin/loft-idle"
spawn-sh-at-startup "exec ~/.local/bin/loft-app music https://howlr.loft.hsimah.com/"
spawn-sh-at-startup "exec ~/.local/bin/loft-app radarr https://radarr.loft.hsimah.com/"
spawn-sh-at-startup "exec ~/.local/bin/loft-app sonarr https://sonarr.loft.hsimah.com/"
spawn-sh-at-startup "exec ~/.local/bin/loft-app lidarr https://lidarr.loft.hsimah.com/"
spawn-sh-at-startup "exec ~/.local/bin/loft-app homepage https://homepage.loft.hsimah.com/"

window-rule {
    match app-id="firefox"
    open-maximized true
    open-fullscreen false
    opacity 1.0
}

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

debug {
    honor-xdg-activation-with-invalid-serial
}
